# carte-bridge environment reference.
# Every variable here is optional: with an empty .env the bridge runs in OPEN
# mode (no auth). That is the intended default — see the Security section of
# README.md before deploying anywhere public.

# ---------------------------------------------------------------------------
# Listener (Docker / VPS / local only — Vercel & Netlify inject their own)
# ---------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Destination policy
# ---------------------------------------------------------------------------
# Comma-separated host allowlist. Empty = every public host is allowed.
# Supports a leading wildcard: *.example.com
ALLOWED_HOSTS=

# Block loopback, private, link-local, CGNAT and cloud-metadata addresses.
# This is the SSRF guard. Keep it true unless you have a specific reason —
# turning it off lets the bridge reach 169.254.169.254 and your internal network.
BLOCK_PRIVATE=true

# Optional bridge authentication. Default is open/no auth.
# Set both values to enable Basic credentials carried in x-bridge-auth.
# BRIDGE_AUTH_MODE can be `none` or `basic`; an explicit `none` disables auth.
BRIDGE_AUTH_MODE=none
BRIDGE_USERNAME=
BRIDGE_PASSWORD=

# ---------------------------------------------------------------------------
# Forwarding behaviour
# ---------------------------------------------------------------------------
# Upstream timeout in milliseconds. Also the max time for a stalled stream.
REQUEST_TIMEOUT_MS=30000

# Bodies up to this size are buffered so a failed attempt can be retried
# against a fallback. Larger bodies stream straight through with no retry.
MAX_BUFFER_BYTES=1048576

# Optional failover origins per route, tried in order on 502/503/504 or
# network error. JSON object, prefix -> array of origins.
# FALLBACKS={"anthropic":["https://api.anthropic.com","https://backup.example.com"]}

# CORS. Empty = no CORS headers emitted. "*" = allow any origin.
# Set a specific origin to allow credentials.
CORS_ORIGIN=

# Whether to believe X-Forwarded-For / X-Real-IP when deciding the client IP.
# Off by default, because those headers are caller-controlled unless something
# you own terminates the connection in front of this bridge. Turn it on only
# behind a reverse proxy (nginx, Caddy, a load balancer) that you operate.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Status page
# ---------------------------------------------------------------------------
# The status page (GET /) shows two addresses: the client's, and the one
# upstream sees. The second needs a lookup service. Any endpoint that returns
# either a bare IP or {"ip": "..."} works.
# Set to empty to disable the lookup; the page then says so instead of guessing.
EGRESS_IP_URL=https://api.ipify.org

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info
# text | json   (json is easier to ingest from a container platform)
LOG_FORMAT=text
