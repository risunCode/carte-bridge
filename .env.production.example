# Copy this file to .env.production for local production-like runs.
# .env.production is ignored by git and must never be committed.

PORT=8080
HOST=0.0.0.0
BLOCK_PRIVATE=true

# Keep `none` if Railway/network access is already restricted.
# Use `basic` to require x-bridge-auth on relay forwarding requests.
BRIDGE_AUTH_MODE=basic
BRIDGE_USERNAME=cartethyia
BRIDGE_PASSWORD=replace-with-a-long-random-password

# Optional: restrict destinations for a public relay.
# ALLOWED_HOSTS=api.anthropic.com,api.openai.com

LOG_LEVEL=info
LOG_FORMAT=text
